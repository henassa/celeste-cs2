+
+/// Voix enregistrée dans la démo (svc_VoiceData), en colonnes pour rester légère :
+/// un seul buffer d'octets et, par paquet, son tick, son SteamID, son format, sa fréquence,
+/// sa position dans le buffer et le découpage en frames (packet_offsets).
+#[wasm_bindgen]
+pub fn parseVoice(file: Vec<u8>) -> Result<JsValue, JsError> {
+    let settings = ParserInputs {
+        wanted_players: vec![],
+        real_name_to_og_name: HashMap::default().into(),
+        wanted_player_props: vec![],
+        wanted_other_props: vec![],
+        wanted_events: vec![],
+        parse_ents: false,
+        wanted_ticks: vec![],
+        parse_projectiles: false,
+        only_header: false,
+        list_props: false,
+        only_convars: false,
+        huffman_lookup_table: &vec![],
+        order_by_steamid: false,
+        wanted_prop_states: HashMap::default().into(),
+        fallback_bytes: None,
+        parse_grenades: false,
+        parse_weapons: false,
+        vector_props_as_lists: false,
+    };
+    let mut parser = Parser::new(settings, ForceSingleThreaded);
+    let output = match parser.parse_demo(&file) {
+        Ok(output) => output,
+        Err(e) => return Err(JsError::new(&format!("{}", e))),
+    };
+    let mut ticks: Vec<i32> = vec![];
+    let mut steamids: Vec<String> = vec![];
+    let mut formats: Vec<i32> = vec![];
+    let mut rates: Vec<u32> = vec![];
+    let mut starts: Vec<u32> = vec![];
+    let mut lens: Vec<u32> = vec![];
+    let mut frame_counts: Vec<u32> = vec![];
+    let mut frame_offsets: Vec<u32> = vec![];
+    let mut bytes: Vec<u8> = vec![];
+    for (tick, packet) in output.voice_data {
+        if let Some(audio) = &packet.audio {
+            let data = audio.voice_data();
+            if data.is_empty() {
+                continue;
+            }
+            ticks.push(tick);
+            steamids.push(packet.xuid().to_string());
+            formats.push(audio.format.unwrap_or(-1));
+            rates.push(audio.sample_rate());
+            starts.push(bytes.len() as u32);
+            lens.push(data.len() as u32);
+            frame_counts.push(audio.packet_offsets.len() as u32);
+            frame_offsets.extend_from_slice(&audio.packet_offsets);
+            bytes.extend_from_slice(data);
+        }
+    }
+    let obj = js_sys::Object::new();
+    let set = |k: &str, v: &JsValue| js_sys::Reflect::set(&obj, &JsValue::from_str(k), v).map(|_| ()).map_err(|_| JsError::new("voice output"));
+    set("ticks", &js_sys::Int32Array::from(&ticks[..]).into())?;
+    set("steamids", &serde_wasm_bindgen::to_value(&steamids).map_err(|e| JsError::new(&format!("{}", e)))?)?;
+    set("formats", &js_sys::Int32Array::from(&formats[..]).into())?;
+    set("sampleRates", &js_sys::Uint32Array::from(&rates[..]).into())?;
+    set("starts", &js_sys::Uint32Array::from(&starts[..]).into())?;
+    set("lengths", &js_sys::Uint32Array::from(&lens[..]).into())?;
+    set("frameCounts", &js_sys::Uint32Array::from(&frame_counts[..]).into())?;
+    set("frameOffsets", &js_sys::Uint32Array::from(&frame_offsets[..]).into())?;
+    set("bytes", &js_sys::Uint8Array::from(&bytes[..]).into())?;
+    Ok(obj.into())
+}
