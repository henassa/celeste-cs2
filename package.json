{
  "name": "celeste",
  "private": true,
  "version": "0.36.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "vitest run",
    "dump": "tsx scripts/dump-match.ts",
    "stats-check": "tsx scripts/stats-check.ts",
    "maps:extract": "node scripts/extract-maps.mjs",
    "anims:extract": "node scripts/extract-anims.mjs",
    "assets:import": "node scripts/import-assets.mjs",
    "desktop": "npm run build && electron .",
    "desktop:dev": "node scripts/desktop-dev.mjs",
    "dist:win": "npm run build && electron-builder --win",
    "dist:linux": "npm run build && electron-builder --linux",
    "android:sync": "npm run build && cap sync android",
    "android:open": "cap open android",
    "android:apk": "npm run android:sync && cd android && ./gradlew assembleDebug",
    "library:build": "tsx scripts/library-build.ts"
  },
  "dependencies": {
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.6.2",
    "meshoptimizer": "^1.3.0",
    "pngjs": "^7.0.0",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@capacitor/android": "^8.6.2",
    "@capacitor/cli": "^8.6.2",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@mlc-ai/web-llm": "^0.2.88",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "^6.1.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "electron": "^45.3.4",
    "electron-builder": "^26.18.0",
    "fzstd": "^0.1.1",
    "lucide-react": "^1.73.0",
    "node-unrar-js": "^2.0.2",
    "oxlint": "^1.90.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "~7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  },
  "description": "Celeste CS2: free, local-first demo review and scrim tool for Counter-Strike 2",
  "license": "MIT",
  "main": "electron/main.cjs",
  "author": "henassa",
  "build": {
    "appId": "app.celeste",
    "productName": "Celeste CS2",
    "copyright": "MIT",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "asar": false,
    "files": [
      "dist/**",
      "electron/**",
      "scripts/**",
      "src/maps/maps.json",
      "build/icon.png",
      "package.json",
      "!scripts/**/*.ts"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "artifactName": "Celeste-CS2-${version}-${arch}-${target}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Celeste CS2"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Game",
      "executableName": "celeste-cs2",
      "icon": "build/icon.png"
    },
    "publish": null,
    "extraResources": [
      {
        "from": "node_modules/three/examples/jsm",
        "to": "app/node_modules/three/examples/jsm",
        "filter": [
          "loaders/**",
          "utils/**",
          "libs/**"
        ]
      }
    ]
  }
}
